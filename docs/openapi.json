    "/api/v1/search": {
      "get": {
        "summary": "Caută în catalog.",
        "description": "`kind = brand-miss` înseamnă că avem categoria dar nu marca cerută; `missing` le numește.\n\nLimită: 300 cereri / 60s per apelant identificat (3000 partajate când apelantul nu poate fi identificat).\nCache: s-maxage=3600, stale-while-revalidate=86400.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Textul căutat.",
            "schema": {
              "type": "string",
              "maxLength": 120
            },
            "example": "lapte"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Câte rezultate. Peste maxim se limitează la maxim, nu se respinge.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          },
          {
            "name": "section",
            "in": "query",
            "required": false,
            "description": "Secțiunea de catalog.",
            "schema": {
              "type": "string",
              "enum": [
                "grocery",
                "alcohol",
                "dcneu",
                "cosmetice",
                "farmacie"
              ],
              "default": "grocery"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
