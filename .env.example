# Copy to .env and fill in.
#
# NOTE: .env is gitignored, but it was TRACKED until Phase 7 — so checking out an older commit
# and returning will DELETE your local .env, because git is restoring a state where the file
# does not exist. That happened during the merge and took DATABASE_URL and a freshly rotated
# AUTH_SECRET with it. If the app suddenly cannot find its database, look here first. .env is gitignored; THIS file is the one that is committed,
# so it must never contain a real secret — only the shape of one.
#
# It was the other way round until Phase 7: .env itself was tracked. Nothing sensitive had
# been written into it yet, which is precisely why it was easy to miss: the first person to
# set a real AUTH_SECRET or a production DATABASE_URL would have committed it without
# noticing, and a secret in git history outlives the commit that removes it.

# SQLite for the MVP. Swap for PostgreSQL in production (change provider in
# prisma/schema.prisma and set a postgres:// URL here).
DATABASE_URL="file:./dev.db"
NEXT_TELEMETRY_DISABLED=1

# Auth session signing secret (set a real random value in production):
# AUTH_SECRET="change-me"
# REQUIRED FOR `npm run build`. metadataBase is baked into the build output, so every
# canonical tag and OpenGraph URL in the artifact comes from this — a build cannot produce
# correct output without knowing its own origin, and it now refuses rather than guessing.
# (Unlike AUTH_SECRET, which is a RUNTIME secret and must not be needed at build time.)
SITE_URL="http://localhost:3200"

# Trust features: the shrinkflation page and the "is this discount real?" verdict.
# BOTH publish a factual claim about a NAMED company. Off unless explicitly enabled,
# and enabling is a decision a person makes after looking at the detections — not a default.
# FEATURE_TRUST="true"
