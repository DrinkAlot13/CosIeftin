# Copy to .env and fill in. .env is gitignored; THIS file is the one that is committed,
# so it must never contain a real secret — only the shape of one.
#
# It was the other way round until Phase 7: .env itself was tracked. Nothing sensitive had
# been written into it yet, which is precisely why it was easy to miss: the first person to
# set a real AUTH_SECRET or a production DATABASE_URL would have committed it without
# noticing, and a secret in git history outlives the commit that removes it.

# SQLite for the MVP. Swap for PostgreSQL in production (change provider in
# prisma/schema.prisma and set a postgres:// URL here).
DATABASE_URL="file:./dev.db"
NEXT_TELEMETRY_DISABLED=1

# Auth session signing secret (set a real random value in production):
# AUTH_SECRET="change-me"
# SITE_URL="https://cosmic.ro"

# Trust features: the shrinkflation page and the "is this discount real?" verdict.
# BOTH publish a factual claim about a NAMED company. Off unless explicitly enabled,
# and enabling is a decision a person makes after looking at the detections — not a default.
# FEATURE_TRUST="true"
