// CoșMic — grocery price comparison data model.
// SQLite for local dev; switch provider to "postgresql" for production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id       Int        @id @default(autoincrement())
  slug     String     @unique
  name     String
  icon     String?
  parentId Int?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]
}

/// A grocery chain (national price in this MVP).
model Merchant {
  id         Int      @id @default(autoincrement())
  slug       String   @unique
  name       String
  websiteUrl String
  /// hex color for the per-store chart legend
  color      String?
  active     Boolean  @default(true)
  offers     Offer[]
  createdAt  DateTime @default(now())
}

/// A canonical pre-set grocery item. Scraped offers match onto one Product.
model Product {
  id         Int               @id @default(autoincrement())
  slug       String            @unique
  name       String
  brand      String?
  ean        String?           @unique
  /// base unit for price normalization: "kg" | "l" | "buc"
  unit       String            @default("buc")
  /// amount per pack in base units (e.g. 1.0 L, 0.5 kg, 10 buc)
  unitSize   Float             @default(1)
  image      String?
  categoryId Int?
  category   Category?         @relation(fields: [categoryId], references: [id])
  offers     Offer[]
  listItems  GroceryListItem[]
  createdAt  DateTime          @default(now())
}

/// One chain's price for one item.
model Offer {
  id           Int            @id @default(autoincrement())
  productId    Int
  product      Product        @relation(fields: [productId], references: [id])
  merchantId   Int
  merchant     Merchant       @relation(fields: [merchantId], references: [id])
  price        Float
  /// price / unitSize (lei per kg / L / buc) — the fair-comparison number
  pricePerUnit Float          @default(0)
  packLabel    String?
  currency     String         @default("RON")
  availability String         @default("in stock")
  url          String
  /// "ean" | "fuzzy" | "new"
  matchedBy    String         @default("fuzzy")
  lastSeen     DateTime       @default(now())
  history      PriceHistory[]

  @@unique([productId, merchantId])
}

model PriceHistory {
  id         Int      @id @default(autoincrement())
  offerId    Int
  offer      Offer    @relation(fields: [offerId], references: [id])
  price      Float
  recordedAt DateTime @default(now())

  @@index([offerId, recordedAt])
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  passwordHash String
  isAdmin      Boolean       @default(false)
  createdAt    DateTime      @default(now())
  lists        GroceryList[]
}

/// A saved shopping list (tied to a user, or anonymous via `token`).
model GroceryList {
  id        Int               @id @default(autoincrement())
  userId    Int?
  user      User?             @relation(fields: [userId], references: [id])
  token     String            @unique
  name      String            @default("Lista mea")
  items     GroceryListItem[]
  createdAt DateTime          @default(now())
}

model GroceryListItem {
  id        Int         @id @default(autoincrement())
  listId    Int
  list      GroceryList @relation(fields: [listId], references: [id])
  productId Int
  product   Product     @relation(fields: [productId], references: [id])
  qty       Int         @default(1)

  @@unique([listId, productId])
}
