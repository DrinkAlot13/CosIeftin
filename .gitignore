node_modules/
.next/
out/
build/
*.log
npm-debug.log*

prisma/dev.db
prisma/dev.db-journal
# Pre-migration snapshots taken by hand before a `prisma db push`. 230 MB each and
# reproducible from the live database, so they are kept locally and never committed.
prisma/dev.db.bak-*

# generated sample "scraped" data (regenerated by `npm run generate-sample`)
data/scraped/*.ndjson

# downloaded product images (regenerated by `npm run download-images`)
public/product-images/

.env.local
.DS_Store
backups/*.db
backups/*.db.gz
backups/history/*.csv

# Local environment. Real secrets live here; .env.example is the committed template.
.env
.env.local
.env.production

# TypeScript incremental build cache — regenerated by every typecheck, so tracking it
# means the pre-commit hook dirties the tree it just validated.
tsconfig.tsbuildinfo
scripts/tmp/
tmp-pools/

# Soak logs are written by the nightly, one file per night. Ignored for the same reason
# backups/*.db is: a generated file tracked in git dirties the working tree every time the
# job runs, and a dirty tree blocks a branch switch — which is exactly what backups/manifest.json
# did to the fix/pepsi-merge merge. Read them with `npm run soak:report`, not with git.
logs/soak/*.json
logs/soak/.tmp/

# The Glovo delivery-address session: cookies plus the coordinates of a real residential
# address. It is credentials-shaped and personal-data-shaped at once, and it is recreated by
# running the address flow once, so it has no business in the repository.
config/glovo-session.json

# Generated reports. `backups/manifest.json` was tracked as generated output and blocked a
# merge; the same shape, so it stays out of the repository. Re-create with `npm run report:tree`.
reports/

# Nightly wrapper output — one file per night, runtime evidence rather than source.
logs/nightly/

# Raw page dumps fetched by the probe scripts — debugging scratch, not source.
logs/*.html
logs/*.json
logs/*.txt
logs/*.xml
logs/flow/
logs/cmp/
